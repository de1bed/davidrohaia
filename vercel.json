{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {"source": "/biblioteca", "destination": "/mini-libros", "permanent": true},
    {"source": "/proyectos", "destination": "/productos", "permanent": false},
    {"source": "/proyectos/:slug", "destination": "/productos", "permanent": false},
    {"source": "/trabajemos", "destination": "/contacto", "permanent": false},
    {"source": "/sobre-mi", "destination": "/", "permanent": false},
    {"source": "/blog", "destination": "/", "permanent": false},
    {"source": "/blog/:slug", "destination": "/", "permanent": false},
    {"source": "/videos/preserved", "destination": "/videos", "permanent": false}
  ],
  "functions": {
    "api/youtube.js": {
      "maxDuration": 30
    },
    "api/subscribe.js": {
      "maxDuration": 10
    },
    "api/instagram.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
